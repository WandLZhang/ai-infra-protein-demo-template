# Copy to .env and fill in. Vite bakes these into the dist/ bundle at build time
# (any value here ships to anyone who loads the deployed page), so use a Maps API
# key restricted by HTTP referrer to your frontend hostnames.

# Google Maps JavaScript API key — must have Maps JavaScript API + Places API enabled.
# Restrict by HTTP referrer in GCP Console to the Firebase hostnames where this is served.
VITE_GOOGLE_MAPS_API_KEY=

# (Optional) Map ID for Advanced Markers / feature layers. Create in GCP Console → Maps.
VITE_GOOGLE_MAPS_MAP_ID=

# Public URL of the deployed state server (the Flask app in ai-infra-demo-proteins/local-controller/).
# Typically the Cloud Run service URL printed by scripts/deploy_server.sh.
VITE_STATE_SERVER=
